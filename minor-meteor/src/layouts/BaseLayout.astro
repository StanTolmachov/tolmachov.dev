---
import '../styles/global.css';
import AnimatedBackground from '../components/ui/AnimatedBackground.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Stanislav Tolmachov — Go Backend Developer',
  description = 'Go backend developer based in Norway. I build production services in Go — REST APIs on chi, PostgreSQL, Redis, Docker and CI. Creator of Synaply, live at synaply.me.',
  ogImage = 'https://tolmachov.dev/opengraph-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Stanislav Tolmachov" />
    <meta name="keywords" content="Stanislav Tolmachov, Go developer, Golang backend developer, Go backend developer Norway, Go REST API, chi router, PostgreSQL, Redis, Docker, GitHub Actions, remote backend developer, junior Go developer, Synaply" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- OpenGraph -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Stanislav Tolmachov — Go Backend Developer" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="tolmachov.dev" />
    <meta property="profile:first_name" content="Stanislav" />
    <meta property="profile:last_name" content="Tolmachov" />
    <meta property="profile:username" content="StanTolmachov" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Stanislav Tolmachov — Go Backend Developer" />

    <!-- Fonts -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme color -->
    <meta name="theme-color" content="#0a0f1a" />
    <meta name="color-scheme" content="dark" />

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Stanislav Tolmachov",
      "givenName": "Stanislav",
      "familyName": "Tolmachov",
      "jobTitle": "Go Backend Developer",
      "url": "https://tolmachov.dev",
      "email": "stan@tolmachov.dev",
      "telephone": "+4792043450",
      "image": "https://tolmachov.dev/opengraph-image.png",
      "description": "Go backend developer based in Norway. Builds production services in Go — REST APIs on chi, PostgreSQL, Redis, Docker and CI. Creator of Synaply, live at synaply.me.",
      "sameAs": [
        "https://github.com/StanTolmachov",
        "https://www.linkedin.com/in/stan-tolmachov/",
        "https://t.me/StasTolmachov",
        "https://synaply.me"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "NO"
      },
      "hasOccupation": {
        "@type": "Occupation",
        "name": "Go Backend Developer",
        "occupationLocation": {
          "@type": "Country",
          "name": "Norway"
        },
        "skills": "Go, Golang, REST API, chi, PostgreSQL, pgx, Redis, Docker, GitHub Actions, Caddy, Linux, JWT, Prometheus, Grafana"
      },
      "knowsAbout": [
        "Go", "Golang", "REST API", "chi", "PostgreSQL", "pgx", "Redis", "Docker",
        "Backend Development", "CI/CD", "GitHub Actions", "Caddy", "Linux", "JWT",
        "Prometheus", "Grafana", "Integration testing", "Anthropic Claude API"
      ],
      "knowsLanguage": [
        {"@type": "Language", "name": "English", "alternateName": "en"},
        {"@type": "Language", "name": "Ukrainian", "alternateName": "uk"},
        {"@type": "Language", "name": "Russian", "alternateName": "ru"}
      ]
    }
    </script>
  </head>
  <body>
    <AnimatedBackground />
    <slot />
  </body>
</html>
